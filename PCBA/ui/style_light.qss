
/* ui/style_light.qss - Light Theme (User-specified palette) */

/* Palette
   Main Background: #F5F7FA (Soft Light Grey)
   Surface/Cards:   #FFFFFF (White)
   Primary Accent:  #2979FF (Royal Blue)
   Secondary Acc:   #9AA5B1 (Medium Slate Grey)
   Primary Text:    #1F2933 (Dark Obsidian)
   Muted Text:      #7B8794 (Cool Muted Grey)
*/

QWidget {
    background-color: #F5F7FA;
    color: #1F2933;
    font-family: Avenir;
    font-size: 10pt;
}

QGroupBox {
    border: 1px solid #9AA5B1;
    border-radius: 6px;
    margin-top: 25px;
    padding: 12px;
    padding-top: 18px;
    background-color: #FFFFFF;
}
QGroupBox::title {
    color: #7B8794;
    font-size: 9pt;
}

QPushButton, QLineEdit, QComboBox {
    border-radius: 6px;
}

QLabel {
    padding: 2px 6px 2px 6px;
    color: #1F2933;
}

QLabel#StatusIndicator {
    font-size: 18pt;
    font-weight: bold;
    color: #1F2933;
    padding: 8px 12px;
    border: 1px solid #E6EEF8;
    border-radius: 6px;
    background-color: #FFFFFF;
    min-width: 140px;
}
QLabel#StatusIndicator[status="loading"] {
    color: #7B8794;
    background-color: #FFFFFF;
    border-color: #E6EEF8;
}
QLabel#StatusIndicator[status="pass"] {
    color: #1F2933;
    background-color: #E6FBFF;
    border-color: #BEE7FF;
}
QLabel#StatusIndicator[status="fail"] {
    color: #FFFFFF;
    background-color: #F87171;
    border-color: #EF4444;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #9AA5B1;
    color: #1F2933;
    padding: 12px 14px;
    border-radius: 6px;
    min-width: 80px;
    min-height: 44px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #F0F6FF;
    border-color: #2979FF;
    color: #1F2933;
}
QPushButton:pressed {
    background-color: #E6F0FF;
}

QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E6EEF8;
    padding: 6px;
    border-radius: 6px;
    color: #1F2933;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2979FF;
}

QSlider::groove:horizontal { height: 6px; background: #E6EEF8; border-radius: 3px; }
QSlider::handle:horizontal { background: #2979FF; width: 14px; margin-top: -4px; margin-bottom: -4px; border-radius: 7px; border: 1px solid #FFFFFF; }

QWidget#TitleBar {
  background-color: #F5F7FA;
  border-bottom: 1px solid #E6EEF8;
}
QLabel#WindowTitle { color: #1F2933; font-weight: 600; font-size: 11pt; padding-left: 6px; }
QPushButton#TitleButton { background: transparent; color: #7B8794; border: none; padding: 6px; border-radius: 6px; min-width: 28px; min-height: 28px; font-size: 11pt; }
QPushButton#TitleButton:hover { background: rgba(41,121,255,0.08); color: #1F2933; }

QMenuBar#MenuBar { background-color: #F5F7FA; color: #1F2933; }
QMenuBar::item:selected { background-color: #FFFFFF; }
QMenu { background-color: #FFFFFF; color: #1F2933; }

#VideoLabel { border: 1px solid #E6EEF8; background-color: #FFFFFF; color: #1F2933; }
