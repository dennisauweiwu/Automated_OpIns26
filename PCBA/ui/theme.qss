/* =============================================================================
   One stylesheet, two palettes.

   @token@ placeholders are substituted at load time from THEME_TOKENS in
   aoi/ui/window.py. Two hand-maintained .qss files drifted apart every time a
   widget was added; a template plus a token table cannot.
   ============================================================================= */

QWidget {
    background: @bg@;
    color: @ink@;
    font-family: "Segoe UI", "Inter", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog { background: @bg@; }

/* Controls inherit the panel they sit on. Without this, every label and
   checkbox paints the window colour and shows as a dark rectangle inside a
   lighter QGroupBox. */
QLabel, QCheckBox, QRadioButton, QGroupBox { background: transparent; }
QGroupBox { background: @panel@; }

/* ---------- title bar ---------- */

#TitleBar {
    background: @panel@;
    border-bottom: 1px solid @line@;
}
#WindowTitle { font-size: 14px; font-weight: 700; letter-spacing: .2px; }
#WindowSubtitle { color: @muted@; font-size: 12px; padding-left: 10px; }

#TitleButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: @muted@;
    font-size: 14px;
}
#TitleButton:hover { background: @chip@; color: @ink@; }
#TitleButtonClose:hover { background: #C43B4C; color: #FFFFFF; }

/* ---------- tabs ---------- */

#MainTabs::pane {
    border: none;
    background: @bg@;
}
QTabBar::tab {
    background: transparent;
    color: @muted@;
    /* Generous horizontal padding and a floor on the width: at the default the
       label is clipped by a pixel or two on some font/DPI combinations. */
    min-width: 86px;
    padding: 9px 24px;
    margin-right: 6px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}
QTabBar::tab:selected {
    color: @ink@;
    border-bottom: 2px solid @accent@;
}
QTabBar::tab:hover:!selected { color: @ink@; }

/* ---------- panels ---------- */

QGroupBox {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: 10px;
    margin-top: 16px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: @muted@;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .6px;
}

#BoardView {
    background: @panel2@;
    border: 1px solid @line@;
    border-radius: 10px;
}
#Chart {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: 10px;
}

/* ---------- KPI cards ---------- */

#KpiCard {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: 10px;
}
#KpiCaption {
    color: @muted@;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .7px;
}
#KpiValue { font-size: 24px; font-weight: 700; }
#KpiValue[tone="ok"]   { color: @ok@; }
#KpiValue[tone="warn"] { color: @warn@; }
#KpiValue[tone="bad"]  { color: @bad@; }
#KpiUnit { color: @muted@; font-size: 12px; padding-bottom: 4px; }

/* ---------- verdict ---------- */

#Verdict {
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: .8px;
    border: 1px solid @line@;
    background: @panel@;
    color: @muted@;
}
#Verdict[state="pass"] {
    background: rgba(63, 191, 127, 0.16);
    border: 1px solid @ok@;
    color: @ok@;
}
#Verdict[state="fail"] {
    background: rgba(224, 82, 99, 0.16);
    border: 1px solid @bad@;
    color: @bad@;
}

#VerdictCard {
    background: @panel@;
    border: 1px solid @line@;
    border-radius: 10px;
    padding: 14px;
}
#Caveat {
    background: @panel2@;
    border-left: 3px solid @warn@;
    border-radius: 6px;
    padding: 10px 12px;
    color: @muted@;
    font-size: 12px;
}

/* ---------- buttons ---------- */

QPushButton {
    background: @panel2@;
    color: @ink@;
    border: 1px solid @line@;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}
QPushButton:hover  { border-color: @accent@; }
QPushButton:pressed { background: @chip@; }
QPushButton:disabled { color: @muted@; border-color: @line@; }

#primaryButton {
    background: @accent2@;
    border: 1px solid @accent@;
    color: #FFFFFF;
}
#primaryButton:hover { background: @accent@; }
#primaryButton:checked {
    background: #C43B4C;
    border-color: #C43B4C;
}
#MiniButton { padding: 4px 12px; font-size: 12px; }

/* ---------- inputs ---------- */

QComboBox, QSpinBox, QLineEdit {
    background: @panel2@;
    border: 1px solid @line@;
    border-radius: 7px;
    padding: 6px 9px;
    min-height: 20px;
}
QComboBox:hover, QSpinBox:hover { border-color: @accent@; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: @panel@;
    border: 1px solid @line@;
    selection-background-color: @accent2@;
    selection-color: #FFFFFF;
    outline: none;
}
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 15px; height: 15px;
    border: 1px solid @line@;
    border-radius: 4px;
    background: @panel2@;
}
QCheckBox::indicator:checked {
    background: @accent@;
    border-color: @accent@;
}
QCheckBox:disabled { color: @muted@; }

QProgressBar {
    background: @panel2@;
    border: 1px solid @line@;
    border-radius: 7px;
    height: 20px;
    text-align: center;
    color: @ink@;
    font-size: 11px;
}
QProgressBar::chunk { background: @accent2@; border-radius: 6px; }

/* ---------- tables ---------- */

QTableWidget {
    background: @panel@;
    alternate-background-color: @panel2@;
    border: 1px solid @line@;
    border-radius: 8px;
    gridline-color: @line@;
    selection-background-color: @accent2@;
    selection-color: #FFFFFF;
}
QHeaderView::section {
    background: @panel2@;
    color: @muted@;
    border: none;
    border-bottom: 1px solid @line@;
    padding: 7px 9px;
    font-size: 11px;
    font-weight: 700;
}
QTableWidget::item { padding: 5px 8px; }

/* ---------- gallery ---------- */

#GalleryRow {
    background: @panel2@;
    border: 1px solid @line@;
    border-radius: 8px;
}
#GalleryRow:hover { border-color: @accent@; }
#GalleryThumb {
    background: @bg@;
    border: 1px solid @line@;
    border-radius: 6px;
}
#GalleryMeta { font-size: 12px; }
#GalleryEmpty { color: @muted@; padding: 26px; font-style: italic; }

/* ---------- misc ---------- */

#Chip {
    background: @chip@;
    border: 1px solid @line@;
    border-radius: 12px;
    padding: 3px 11px;
    color: @muted@;
    font-size: 11px;
}
#Chip[tone="warn"] {
    border-color: @warn@;
    color: @warn@;
}
#Muted { color: @muted@; font-size: 12px; }

QScrollArea { border: none; background: transparent; }
QScrollBar:vertical {
    background: transparent; width: 10px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: @line@; border-radius: 5px; min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: @muted@; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal {
    background: @line@; border-radius: 5px; min-width: 28px;
}

QStatusBar {
    background: @panel@;
    border-top: 1px solid @line@;
    color: @muted@;
}
QToolTip {
    background: @panel@;
    color: @ink@;
    border: 1px solid @line@;
    border-radius: 6px;
    padding: 6px 8px;
}
QSplitter::handle { background: transparent; }
QSplitter::handle:vertical { height: 6px; }
